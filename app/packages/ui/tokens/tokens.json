{
  "$schema": "./tokens.schema.json",
  "name": "Ink and Ivory",
  "source": "Blueprint v1.6 Section 11.3; never vivid red as brand, never black-and-white-with-red, never Helvetica",
  "light": {
    "bg": "#FBF8F3",
    "surface": "#FFFFFF",
    "surface-2": "#F3EEE6",
    "border-subtle": "#E3DCCF",
    "border": "#C9BFAE",
    "border-strong": "#857B68",
    "input": "#857B68",
    "text": "#121A2B",
    "text-secondary": "#3F4A5F",
    "text-muted": "#5F6B7E",
    "primary": "#121A2B",
    "primary-foreground": "#FBF8F3",
    "accent-solid": "#D9A21B",
    "accent-foreground": "#121A2B",
    "accent-outline": "#A6780A",
    "accent-text": "#8A5B00",
    "success-text": "#1B6B3A",
    "success-solid": "#1F8A4C",
    "warning-text": "#8A5B00",
    "danger-text": "#A32D2D",
    "danger-solid": "#C0392B",
    "danger-foreground": "#FFFFFF",
    "ai-bg": "#EFEAFB",
    "ai-text": "#5B3FA6",
    "focus": "#2F5FD0",
    "chart-1": "#D9A21B",
    "chart-2": "#121A2B",
    "chart-3": "#5F6B7E",
    "chart-4": "#1F8A8A",
    "chart-5": "#5B3FA6"
  },
  "dark": {
    "bg": "#0B1220",
    "surface": "#121A2B",
    "surface-2": "#1A2438",
    "border-subtle": "#243049",
    "border": "#34425C",
    "border-strong": "#5C6B86",
    "input": "#5C6B86",
    "text": "#F4EFE6",
    "text-secondary": "#C9C2B6",
    "text-muted": "#9AA3B5",
    "primary": "#F4EFE6",
    "primary-foreground": "#0B1220",
    "accent-solid": "#E6B54A",
    "accent-foreground": "#121A2B",
    "accent-outline": "#E6B54A",
    "accent-text": "#F0C45E",
    "success-text": "#5FD38A",
    "success-solid": "#2EA862",
    "warning-text": "#F0C45E",
    "danger-text": "#F48A8A",
    "danger-solid": "#EB5A5E",
    "danger-foreground": "#121A2B",
    "ai-bg": "#1E1A33",
    "ai-text": "#B9A7F2",
    "focus": "#8FB0FF",
    "chart-1": "#E6B54A",
    "chart-2": "#F4EFE6",
    "chart-3": "#9AA3B5",
    "chart-4": "#3FB8B8",
    "chart-5": "#B9A7F2"
  },
  "contrast_requirements": {
    "comment": "WCAG 2.2 AA: text pairs at least 4.5:1, UI and focus pairs at least 3:1. Checked by scripts/check-contrast.mjs in both themes.",
    "text_pairs": [
      ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
      ["text-secondary", "bg"], ["text-secondary", "surface"],
      ["text-muted", "bg"], ["text-muted", "surface"],
      ["primary-foreground", "primary"],
      ["accent-foreground", "accent-solid"],
      ["accent-text", "bg"], ["accent-text", "surface"],
      ["success-text", "bg"], ["warning-text", "bg"], ["danger-text", "bg"],
      ["danger-foreground", "danger-solid"],
      ["ai-text", "ai-bg"], ["ai-text", "surface"]
    ],
    "ui_pairs": [
      ["border-strong", "bg"], ["input", "surface"], ["focus", "bg"], ["focus", "surface"], ["accent-outline", "bg"]
    ]
  },
  "prompter": {
    "comment": "Deferred feature (F3.8), tokens kept: ivory on near-black, 48 to 64 px",
    "bg": "#000000",
    "text": "#F4EFE6"
  },
  "type_scale": {
    "comment": "Blueprint 11.2. Base 16px; sizes in px, line-height in px, tracking in em",
    "display":      { "size": 40, "line": 44, "weight": 600, "tracking": -0.02, "family": "display" },
    "page-title":   { "size": 28, "line": 36, "weight": 600, "tracking": -0.015, "family": "ui" },
    "title":        { "size": 22, "line": 28, "weight": 600, "tracking": -0.01, "family": "ui" },
    "section":      { "size": 18, "line": 26, "weight": 600, "tracking": 0, "family": "ui" },
    "lede":         { "size": 18, "line": 28, "weight": 400, "tracking": 0, "family": "editorial" },
    "body":         { "size": 16, "line": 24, "weight": 400, "tracking": 0, "family": "ui" },
    "editor-body":  { "size": 19, "line": 30, "weight": 400, "tracking": 0, "family": "editorial", "maxWidth": "66ch" },
    "compact":      { "size": 14, "line": 20, "weight": 400, "tracking": 0, "family": "ui" },
    "label":        { "size": 13, "line": 18, "weight": 500, "tracking": 0.01, "family": "ui" },
    "metadata":     { "size": 12, "line": 16, "weight": 500, "tracking": 0.02, "family": "ui" },
    "timer":        { "size": 64, "line": 72, "weight": 500, "tracking": 0, "family": "mono" }
  },
  "fonts": {
    "ui": "Inter, \"Noto Sans Devanagari\", \"Noto Sans\", system-ui, sans-serif",
    "editorial": "Newsreader, Georgia, serif",
    "display": "Fraunces, Newsreader, Georgia, serif",
    "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "radius": { "control": 8, "card": 12, "modal": 16 },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "layout": { "rail": 240, "railCollapsed": 64, "contentMax": 1120, "rightPanel": 320, "gutterMobile": 16 }
}
